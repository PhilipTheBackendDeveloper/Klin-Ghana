# Powers the admin AI Assistant chat (api/ai/assistant.ts) via Cloudflare
# Workers AI's free tier — dash.cloudflare.com -> Workers AI for the account
# ID, and My Profile -> API Tokens (Workers AI Read/Edit template) for the
# token. Never expose either with a VITE_ prefix — server-only.
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# Local IoT endpoint used by simulator and firmware fallback testing.
IOT_ENDPOINT_URL=http://localhost:3001/api/iot-telemetry
IOT_SERVER_PORT=3001